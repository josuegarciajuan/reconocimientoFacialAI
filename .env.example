# Copia este fichero a `.env` (que NO se commitea) y ajusta los valores.
# Ver docs/specs/06-plan-bugs-mejoras.md (M10).

# URL pública del panel (según despliegue). Se usa para enlaces/imágenes que ve
# el NAVEGADOR, así que debe ser una URL alcanzable por el cliente.
RF_URL=http://localhost/reconocimientoFacial/

# URL INTERNA del motor al ws.php (mismo host). El capturador la usa para
# consultar las cámaras y para el endpoint de alarmas del guarda. Debe apuntar a
# 127.0.0.1/localhost (nunca a la IP pública: muchos hosts cloud no tienen
# hairpin NAT y la petición del host a su propia IP pública se queda en timeout,
# dejando la captura con 0 cámaras). Opcional: por defecto 127.0.0.1:8090.
RF_URL_INTERNAL=http://127.0.0.1:8090/reconocimientoFacial/

# Superadmin del panel
RF_ADMIN_USER=admin
RF_ADMIN_PASS=cambiar-ahora

# Base de datos
RF_DB_NAME=reconocimientofacial
RF_DB_USER=root
RF_DB_PASS=
RF_DB_HOST=localhost

# Rutas del proyecto
RF_RUTA=/root/reconocimientoFacial/
RF_PYTHON=/root/reconocimientoFacial/motor/venv/bin/python

# FTP/SFTP legacy (solo si el capturador corre en otra máquina)
RF_FTP_HOST=localhost
RF_FTP_USER=
RF_FTP_PASS=

# Secreto HMAC para el streaming en directo (servicio rf-live / live/mjpeg-stream.js).
# Debe ser aleatorio (p. ej. `openssl rand -hex 32`). Si está vacío, el flujo /live no exige token.
RF_LIVE_TOKEN=cambiar-por-secreto-aleatorio

# Vídeos de movimiento (compresión H.264 + retención). Opcionales: si faltan,
# se usan los valores por defecto de config/config.php.
# CRF 20 = calidad prioritaria (calidad perceptiva alta a 10 fps; el detalle de
# caras pequeñas alimenta SR/GFPGAN aguas abajo). Subirlo (26+) ahorra disco a
# costa de nitidez en caras lejanas.
RF_VIDEO_CRF=20
RF_VIDEO_FPS_ARCHIVO=10
RF_VIDEO_PRESET=medium
RF_VIDEO_RETENCION_DIAS=30
RF_LIMITE_ARCHIVA=2

# Detección de movimiento (guarda_movimientosV3.py, globales). Opcionales:
# si faltan, se usan los valores legacy (21/21/2 = sin cambio de comportamiento).
RF_MOV_THRESHOLD=21   # umbral de diferencia de píxel (antes hardcodeado)
RF_MOV_BLUR=21        # kernel GaussianBlur (antes hardcodeado)
RF_MOV_DILATE=2       # iteraciones de dilate (antes hardcodeado)

# Umbrales de matching (matcher ArcFace). Opcionales: el calibrador (ritual E /
# motor/eval/eval.py) los sugiere desde TAR/FAR sobre el set etiquetado.
RF_MATCH_THRESHOLD=0.30   # similitud coseno mínima para match (match_threshold)
RF_MARGIN=0.03            # separación top1-top2 para no confundir identidades
RF_SECURE_THRESHOLD=0.45  # >= esto: match seguro (0.45 desde 2026-08-21; la banda
                          # [0.30,0.45) exige corroboración de capas o revision)

# Motor de decisión situacional (reenfoque A+B, motor/core/fusion.py+router.py).
# La decisión ya NO es una media ponderada: cada situación elige la capa AUTORIDAD
# (cara/perfil), las que CONFIRMAN por ACUERDO (silueta en perfil/ángulos) y las
# que corroboran/vetan en la zona gris. La identidad la decide SOLO la capa de
# cara: "new" <=> s1 < match_threshold; s1 >= secure_threshold nunca es "new".
RF_CASCADE_ENABLED=1            # motor situacional (reemplaza la decisión binaria)
RF_TORSO_ENABLED=1              # capa L1b torso/ropa (apoyo en gris; 1 desde 2026-08-21)
RF_ATTRIBUTES_ENABLED=0         # atributos visibles estructurados (solo apoyo)
RF_ATTRIBUTES_WEIGHT=0.02       # peso bajo; nunca crea/une identidades
RF_SILUETA_ENABLED=1            # silueta geométrica (acuerdo en perfil/ángulos)
RF_PERFIL_LAYER_ENABLED=1       # matching pose-consciente (perfil, en L1a)
RF_VLM_ENABLED=1                # VLM local (Ollama) solo desempate en gris
RF_OPENAI_ENABLED=1             # OpenAI solo desempate en gris (último recurso)
RF_MIN_LAYER_CONF=0.70          # confianza mínima para que una capa de apoyo vote
RF_LLM_MIN_CONF=0.85            # LLM: más estricto (sobreconfianza sin calibrar)
RF_VETO_CONF=0.85               # contradicción FUERTE (s < gray_low y c >= esto)
# Banda baja (anti-fragmentación de perfiles/espaldas): coseno en
# [RF_NEW_LOW_FLOOR, match_threshold) con >= RF_LOW_BAND_AGREEMENTS capas de
# apoyo en acuerdo fuerte asocia a top1 en vez de crear "new" en silencio.
RF_NEW_LOW_FLOOR=0.15
RF_LOW_BAND_AGREEMENTS=2
# Early-exit frontal solo si margen top1-top2 >= esto; si el 2º está cerca se
# corrobora (las capas de apoyo pueden vetar un falso merge).
RF_EARLY_EXIT_MIN_MARGIN=0.06
RF_SILUETA_MIN_SCORE=0.50       # silueta >= esto confirma el acuerdo; < bloquea
RF_CALIB_APPLY=0                # aplicar calib_model.pkl (pesos) al arranque/reload

# Detección de cruces de línea (motor/cruces.py). Opcionales: el calibrador
# (ritual D) los sugiere cruzando la línea N veces.
RF_CRUCE_AREA_MIN=800          # contorno mínimo (px², frame completo) para un cruce
RF_CRUCE_MIN_TRACK_FRAMES=3    # persistencia mínima del objeto (anti-parpadeo)
RF_CRUCE_VAR_THRESHOLD=25      # sensibilidad MOG2 (más bajo = más sensible)

# Procesado de vídeos (procesa_video.py en paralelo). RF_LIMITE_VIDEOS limita
# los procesa_video simultáneos (cada uno ~1.5 GB con insightface a 1280):
# bájalo si la máquina comparte RAM con otros proyectos (p. ej. autotube).
# 1 = procesa de uno en uno (los vídeos encolan; nada se pierde).
RF_LIMITE_VIDEOS=1

# Pool de clasificadores (detector.php): nº de cámaras por proceso clasificador.
# Un proceso carga el stack insightface completo (~1 GB); subir este valor
# reduce el nº de procesos y la RAM total de modelos. La clasificación es
# diferida (las fotos esperan en sinclasificar/), así que 8 (1 proceso para
# todas las cámaras del local) es viable en locales poco concurridos.
RF_CLASIF_CAMS_POR_PROC=8

# RAM-gate del clasificador (motor/core/config.py): si la memoria disponible
# baja de este umbral (GB), los clasificadores duermen y no procesan (evita el
# pico que dispara el OOM killer global).
RF_RAM_MIN_FREE_GB=2.0

# --- Recall (specs/17): capturar≠admitir y recuperación ---
# Objetivo: que ninguna persona se quede sin registrar. La sensibilidad fina se
# ajusta POR CÁMARA en el panel (Configuración > Cámara); estas son las globales.
# Fase 1 (captura): disparador multicontorno y pre/post-roll.
RF_MOV_THRESHOLD=15          # umbral de diferencia de píxel (más bajo = más sensible)
RF_MOV_BLUR=15               # kernel GaussianBlur
RF_MOV_DILATE=2              # iteraciones de dilate
RF_MOV_SUM_FACTOR=2.0        # suma de contornos >= dontCare × factor (0 = desactivado)
RF_CAMARA_FALLOS_RECONECTAR=20  # frames sin RTSP antes de reconectar la cámara
RF_VIDEO_SEG_ANTES=4         # pre-roll (s): recupera a quien entra rápido
RF_VIDEO_SEG_DESPUES=4       # post-roll (s): recupera a quien sale
# Fase 2 (extracción): no descartar caras utilizables; decidir al admitir.
RF_CAPTURE_KEEP_ALL=1        # guardar caras aunque no alcancen min_sharpness de admisión
RF_CAPTURE_MIN_SHARPNESS=20  # suelo de captura (solo evita guardar ruido)
RF_CAPTURE_MIN_DET=0.3       # min_score de RetinaFace en extracción
RF_FACE_EVERY=2              # 1 = analiza todos los frames (más CPU y más recall)
# Fase 3 (reconciliación): co-ocurrencia + provisionales de espaldas.
RF_COOCCUR_WINDOW_S=6.0      # dos personas en la misma cámara a la vez = distintas
RF_PROVISIONAL_BACKS=1       # crear persona provisional desde un cuerpo sin cara
RF_PROVISIONAL_MIN_COS=0.55  # parecido de torso para reconciliar un provisional

# --- Hilos de CPU (anti-sobresuscripción, ver docs/specs/16) ---
# ONNX Runtime usa por defecto un pool intra-op del nº de cores FÍSICOS por
# CADA sesión ONNX; buffalo_l crea 5 sesiones -> ~50 hilos por proceso. Con
# varios procesos del motor a la vez la máquina hace thrashing (runqueue ~50
# sobre 10 cores, ~79k cambios de contexto/s) y el panel va lento. Estos topes
# NO cambian resultados/precisión: solo cómo se reparte el trabajo entre hilos.
# Regla: (procesos de inferencia) × RF_ORT_THREADS <= cores.
RF_ORT_THREADS=2    # hilos intra-op por sesión ONNX (no cambia el resultado)
RF_CV_THREADS=1     # hilos internos de OpenCV (cv2.setNumThreads)
RF_TORCH_THREADS=1  # hilos de torch (rf-photo lo sube a 4 en su unit)

# Resolución/calidad del motor de visión (opcional; defaults en motor/core/config.py).
# RF_SR_TARGET_SIDE: lado mayor mínimo de las fotos finales (hoy 512).
# RF_SR_EMBED_MIN_FACE: caras con lado mayor < este valor se super-resuelven
#   ANTES del embedding ArcFace (hoy 160: mejora el matching de caras pequeñas).
# RF_SR_FACE_WEIGHT: mezcla GFPGAN/salida-SR (0..1). 0.7 = cara más nítida
#   (menos reescalado borroso); vigilar "plastificado" y deriva de identidad.
# RF_MIN_DISPLAY_SIDE: top-up LANCZOS4 de display de la foto final (512).
# RF_FACE_RESTORE_MIN_SIDE: GFPGAN solo si la cara ORIGINAL (pre-SR) tiene lado
#   mayor >= esto; 48 = restaura también caras pequeñas (foto del panel "siempre" con GFPGAN).
RF_SR_TARGET_SIDE=512
RF_SR_MIN_SIDE=384
RF_SR_EMBED_MIN_FACE=160
RF_MIN_DISPLAY_SIDE=512
RF_FACE_RESTORE_MIN_SIDE=48
RF_MIN_SHARPNESS=55
RF_ENROLL_MIN_SHARPNESS=95
RF_DET_SIZE=1280
RF_CROP_DET_SIZE=640
RF_FACE_FILL=0.70
RF_FACE_MIN_PAD=8
RF_SR_FACE_WEIGHT=0.70

# Super-resolución multi-frame (MF-SR): para caras pequeñas (< RF_SR_MF_MIN_FACE)
# se alinean y fusionan los K crops más nítidos de la misma cara antes del
# SR/GFPGAN. Mejora la nitidez sin tocar cámaras (ver docs/specs/06, resolución).
# ON: K=4 (compromiso calidad/CPU); requiere CPU libre (ver RF_LIMITE_VIDEOS).
RF_SR_MODEL=compact
RF_SR_MF_ENABLED=1
RF_SR_MF_K=4
RF_SR_MF_MIN_FACE=160

# Foto final de BUSTO (display): la cara ocupa ~RF_BUSTO_FACE_FILL del encuadre y
# solo la cara se restaura con GFPGAN (el torso queda con píxeles reales).
# 0.50 = cara más legible que 0.40 manteniendo contexto de persona.
RF_BUSTO_ENABLED=1
RF_BUSTO_FACE_FILL=0.50

# Foto final HQ progresiva: la versión rápida (compact, SIN GFPGAN) aparece al
# instante y, si RF_HQ_ENABLED=1, el worker único rf-photo (motor/photo_worker.py)
# genera la versión HQ (RF_SR_MODEL_PHOTO + GFPGAN) que el panel "autonitida"
# ~35-40 s después sin recargar. Se encola SIEMPRE (también con compact: el
# worker aplica GFPGAN sobre la foto del panel). Los embeddings SIEMPRE usan
# RF_SR_MODEL (compact). RF_HQ_MAX_WORKERS limita la concurrencia (serial: 1).
# RF_HQ_MAX_LOAD: si loadavg(1m) lo supera, el worker duerme (0 = sin gate).
# RF_HQ_MAX_QUEUE: tope de jobs en disco; al superarlo se descartan los MÁS ANTIGUOS.
RF_SR_MODEL_PHOTO=x4plus
RF_HQ_ENABLED=1
RF_HQ_MAX_WORKERS=1
RF_HQ_MAX_LOAD=8.0
RF_HQ_MAX_QUEUE=300

# LLM/VLM — cascada de fusión (ver docs). RF_LLM_API_KEY es SECRETA:
# se pone SOLO en .env (este fichero se commitea sin valores).
RF_LLM_API_KEY=
RF_LLM_MODEL=gpt-4o-mini
RF_LLM_DAILY_BUDGET=100
RF_VLM_BASE_URL=http://localhost:11434
RF_VLM_MODEL=qwen2.5vl:3b
RF_VLM_NUM_CTX=4096
RF_VLM_NUM_GPU=0
RF_VLM_TIMEOUT_S=90
RF_VLM_KEEP_ALIVE_S=300
RF_VLM_MAX_PENDING=20
RF_VLM_RAM_DEFER_GB=2.0
RF_VLM_RAM_SKIP_GB=1.0

# --- Producción / auto-despliegue (deploy/deploy_prod.sh) ---
# El host y la clave de producción NO se versionan: se definen SOLO en el `.env`
# real de cada entorno (este fichero es la plantilla, sin valores).
# deploy_prod.sh los usa para hacer `git pull` + reinicio de los servicios
# afectados en el servidor de producción.
RF_PROD_HOST=
RF_PROD_SSH_USER=root
RF_PROD_SSH_PASS=
RF_PROD_SSH_PORT=22
RF_PROD_PATH=/root/reconocimientoFacial
