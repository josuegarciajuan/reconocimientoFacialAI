# Copia este fichero a `.env` (que NO se commitea) y ajusta los valores.
# Ver docs/specs/06-plan-bugs-mejoras.md (M10).

# URL pública del panel (según despliegue)
RF_URL=http://localhost/reconocimientoFacial/

# Superadmin del panel
RF_ADMIN_USER=admin
RF_ADMIN_PASS=cambiar-ahora

# Base de datos
RF_DB_NAME=reconocimientofacial
RF_DB_USER=root
RF_DB_PASS=
RF_DB_HOST=localhost

# Rutas del proyecto
RF_RUTA=/root/reconocimientoFacial/
RF_PYTHON=/root/reconocimientoFacial/motor/venv/bin/python

# FTP/SFTP legacy (solo si el capturador corre en otra máquina)
RF_FTP_HOST=localhost
RF_FTP_USER=
RF_FTP_PASS=

# Secreto HMAC para el streaming en directo (servicio rf-live / live/mjpeg-stream.js).
# Debe ser aleatorio (p. ej. `openssl rand -hex 32`). Si está vacío, el flujo /live no exige token.
RF_LIVE_TOKEN=cambiar-por-secreto-aleatorio

# Vídeos de movimiento (compresión H.264 + retención). Opcionales: si faltan,
# se usan los valores por defecto de config/config.php.
RF_VIDEO_CRF=26
RF_VIDEO_FPS_ARCHIVO=10
RF_VIDEO_PRESET=medium
RF_VIDEO_RETENCION_DIAS=30
RF_LIMITE_ARCHIVA=2

# Procesado de vídeos (procesa_video.py en paralelo). RF_LIMITE_VIDEOS limita
# los procesa_video simultáneos (cada uno ~1.5 GB con insightface a 1280):
# bájalo si la máquina comparte RAM con otros proyectos (p. ej. autotube).
RF_LIMITE_VIDEOS=2

# RAM-gate del clasificador (motor/core/config.py): si la memoria disponible
# baja de este umbral (GB), los clasificadores duermen y no procesan (evita el
# pico que dispara el OOM killer global).
RF_RAM_MIN_FREE_GB=2.0

# Resolución/calidad del motor de visión (opcional; defaults en motor/core/config.py).
# RF_SR_TARGET_SIDE: lado mayor mínimo de las fotos finales (hoy 512).
# RF_SR_EMBED_MIN_FACE: caras con lado mayor < este valor se super-resuelven
#   ANTES del embedding ArcFace (hoy 96). Subirlo (p. ej. 160) mejora el
#   matching de caras pequeñas sin cambiar el tamaño de la foto.
RF_SR_TARGET_SIDE=512
RF_SR_MIN_SIDE=320
RF_SR_EMBED_MIN_FACE=96
RF_MIN_SHARPNESS=55
RF_DET_SIZE=1280
RF_CROP_DET_SIZE=640
RF_FACE_FILL=0.70
RF_FACE_MIN_PAD=8

# LLM/VLM — cascada de fusión (ver docs). RF_LLM_API_KEY es SECRETA:
# se pone SOLO en .env (este fichero se commitea sin valores).
RF_LLM_API_KEY=
RF_LLM_MODEL=gpt-4o-mini
RF_LLM_DAILY_BUDGET=100
RF_VLM_BASE_URL=http://localhost:11434
RF_VLM_MODEL=qwen2.5vl:3b
RF_VLM_NUM_CTX=4096
RF_VLM_NUM_GPU=0
RF_VLM_TIMEOUT_S=90
RF_VLM_KEEP_ALIVE_S=300
RF_VLM_MAX_PENDING=20
RF_VLM_RAM_DEFER_GB=2.0
RF_VLM_RAM_SKIP_GB=1.0
