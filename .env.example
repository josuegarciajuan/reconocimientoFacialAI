# Copia este fichero a `.env` (que NO se commitea) y ajusta los valores.
# Ver docs/specs/06-plan-bugs-mejoras.md (M10).

# URL pública del panel (según despliegue)
RF_URL=http://localhost/reconocimientoFacial/

# Superadmin del panel
RF_ADMIN_USER=admin
RF_ADMIN_PASS=cambiar-ahora

# Base de datos
RF_DB_NAME=reconocimientofacial
RF_DB_USER=root
RF_DB_PASS=
RF_DB_HOST=localhost

# Rutas del proyecto
RF_RUTA=/root/reconocimientoFacial/
RF_PYTHON=/root/reconocimientoFacial/motor/venv/bin/python

# FTP/SFTP legacy (solo si el capturador corre en otra máquina)
RF_FTP_HOST=localhost
RF_FTP_USER=
RF_FTP_PASS=
