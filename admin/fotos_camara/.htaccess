# Snapshots de la rejilla "Cámaras en directo" (dofoto.py).
#
# Cada fichero se pide con ?v=<mtime> (URL inmutable por versión), así que se
# puede cachear de forma agresiva: el navegador solo vuelve a descargar cuando el
# mtime cambia y la URL es nueva. Con esto el refresco de la rejilla no genera
# tráfico entre cambios.
#
# Directivas bajo <IfModule> para no romper (500) si el módulo no está cargado.

<IfModule mod_headers.c>
    <FilesMatch "\.(jpg|jpeg)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpeg "access plus 1 year"
</IfModule>
