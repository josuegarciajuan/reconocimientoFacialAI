[Unit]
Description=RF Live (MJPEG) — streaming RTSP→MJPEG para la sección "En Directo" del panel
After=network.target apache2.service
Wants=apache2.service

[Service]
Type=simple
WorkingDirectory=/root/reconocimientoFacial
ExecStart=/usr/bin/node /root/reconocimientoFacial/live/mjpeg-stream.js
Restart=always
RestartSec=5
User=root
# Solo loopback; Apache (vhost :8090) expone /reconocimientoFacial/live vía proxy
# Los ffmpeg RTSP→MJPEG (uno por espectador) comparten los cores de la web (0-1)
# para no robar CPU a captura (2-4) ni a inferencia (5-9).
CPUAffinity=0-1
Environment=LIVE_PORT=8084
# RF_WS_URL y RF_LIVE_TOKEN se toman del .env (EnvironmentFile) para que la
# instancia personal pueda apuntar a su propio /ojos/ws.php.
# RF_LIVE_TOKEN se inyecta desde /root/reconocimientoFacial/.env en la instalación
EnvironmentFile=-/root/reconocimientoFacial/.env

[Install]
WantedBy=multi-user.target
