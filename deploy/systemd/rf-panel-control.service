[Unit]
Description=RF Panel de control (p1) — validador de pose (pose.py) para registro webcam
After=network.target

[Service]
Type=simple
WorkingDirectory=/root/reconocimientoFacial
ExecStart=/usr/bin/php /root/reconocimientoFacial/procesos_panel_control.php 0
Restart=always
RestartSec=5
User=root
# Interactivo (registro por webcam): se queda en los cores de la web (0-2).
CPUAffinity=0-2
# Hilos fijos: pose.py usa insightface (ORT) + OpenCV; no debe sobresuscribir
# con el resto del motor (mismos topes que rf-detector).
Environment=OMP_NUM_THREADS=1
Environment=OPENBLAS_NUM_THREADS=1
Environment=MKL_NUM_THREADS=1
Environment=RF_CV_THREADS=1
Environment=RF_ORT_THREADS=2
Environment=RF_ORT_PROVIDER=openvino

[Install]
WantedBy=multi-user.target
