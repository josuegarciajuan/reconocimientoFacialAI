[Unit]
Description=RF Pipeline — despacho, recolección, reconciliación y sesiones
After=network.target mysql.service
Wants=mysql.service

[Service]
Type=simple
WorkingDirectory=/root/reconocimientoFacial
ExecStart=/root/reconocimientoFacial/motor/venv/bin/python /root/reconocimientoFacial/motor/pipeline_service.py --ruta /root/reconocimientoFacial --publications /root/reconocimientoFacial/motor/logs/pipeline_publications.jsonl
Restart=always
RestartSec=5
User=root
Nice=5
# El despacho/recolección son E/S ligera; se dejan en los cores de web/DB para
# no competir con la captura (2-4) ni con la inferencia (5-9).
CPUAffinity=0-1
Environment=OMP_NUM_THREADS=1
Environment=OPENBLAS_NUM_THREADS=1
Environment=MKL_NUM_THREADS=1
Environment=RF_PIPELINE_DISPATCH_S=2
Environment=RF_PIPELINE_COLLECT_S=2
Environment=RF_PIPELINE_RECONCILE_S=30
Environment=RF_PIPELINE_SESSIONS_S=10
Environment=RF_PIPELINE_RETENTION_S=3600
Environment=RF_PIPELINE_METRICS_S=30
Environment=RF_PIPELINE_CLOSE_AFTER_S=30
Environment=RF_PIPELINE_UNITS_MAX_AGE_H=6
# La unit se instala sin habilitar. `deploy/start_pipeline.sh` la activa de
# forma controlada; el interruptor interno ya está listo.
Environment=RF_PIPELINE_ENABLED=1
MemoryMax=1G

[Install]
WantedBy=multi-user.target
