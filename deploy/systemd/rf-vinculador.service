[Unit]
Description=RF Vinculador (p7) — enlaza vídeos de movimiento, estancias (personas) y cruces de línea
After=network.target mysql.service
Wants=mysql.service

[Service]
Type=simple
WorkingDirectory=/root/reconocimientoFacial
ExecStart=/usr/bin/php /root/reconocimientoFacial/vinculador.php
Restart=always
RestartSec=5
User=root
# Diferible (backfill de vínculos, I/O BD): cores de la web (0-2).
CPUAffinity=0-2

[Install]
WantedBy=multi-user.target
