[Unit]
Description=RF Calibración por volumen — sondeo cada 60 min (auto-refinamiento)

# El timer SOLO SONDEA: motor/calibrar.py decide cuándo calibrar según el
# VOLUMEN NUEVO de etiquetas del panel (motor/calib/last_labels.json). Con
# pocas etiquetas el sondeo es barato (salida inmediata).

[Timer]
OnCalendar=*-*-* *:0/60:00
Persistent=true

[Install]
WantedBy=timers.target
