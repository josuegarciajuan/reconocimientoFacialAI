[Unit]
Description=RF Conciliador de fichajes (p6) — concilia entradas/salidas con horario del local
After=network.target mysql.service
Wants=mysql.service

[Service]
Type=simple
WorkingDirectory=/root/reconocimientoFacial
ExecStart=/usr/bin/php /root/reconocimientoFacial/conciliador.php
Restart=always
RestartSec=5
User=root
# Diferible y ligero (I/O BD): cores de la web (0-2).
CPUAffinity=0-1

[Install]
WantedBy=multi-user.target
