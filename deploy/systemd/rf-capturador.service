[Unit]
Description=RF Capturador (p4) — captura de vídeo por movimiento (guarda_movimientosV3)
After=network.target mysql.service
Wants=mysql.service

[Service]
Type=simple
WorkingDirectory=/root/reconocimientoFacial
ExecStart=/usr/bin/php /root/reconocimientoFacial/capturador.php
Restart=always
RestartSec=5
User=root
# Prioridad de CPU MÁXIMA (Tier 1, captura en tiempo real): los
# guarda_movimientosV3 hijos heredan Nice=-10 frente a clasificación/procesado.
Nice=-10
# Hilos fijos: los guarda_movimientosV3 + ffmpeg no deben sobresuscribir los 10
# cores. OMP/OpenBLAS/MKL a 1 y el pool interno de OpenCV a 1 (RF_CV_THREADS,
# motor/core/threads.py); el resultado de la detección de movimiento es idéntico.
Environment=OMP_NUM_THREADS=1
Environment=OPENBLAS_NUM_THREADS=1
Environment=MKL_NUM_THREADS=1
Environment=RF_CV_THREADS=1
# Tope de memoria del cgroup (capturador + 8 guarda_movimientosV3 + ffmpeg):
# protege a los demás servicios de la máquina (autotube) si la RAM escasea.
MemoryMax=5G
# Logs a journald (rotación gestionada por el sistema)

[Install]
WantedBy=multi-user.target
