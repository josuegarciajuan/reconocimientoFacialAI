[Unit]
Description=RF Detector (p5) — orquesta procesa_video.py + clasificador.py
After=network.target mysql.service
Wants=mysql.service

[Service]
Type=simple
WorkingDirectory=/root/reconocimientoFacial
ExecStart=/usr/bin/php /root/reconocimientoFacial/detector.php
Restart=always
RestartSec=5
User=root
# Tope de memoria del cgroup (detector + 12 clasificadores + procesa_video):
# si se supera, el OOM killer actúa DENTRO de rf (reinicia el clasificador más
# grande) y nunca mata procesos de autotube. Ajustable a la RAM de la máquina.
MemoryMax=9G

[Install]
WantedBy=multi-user.target
