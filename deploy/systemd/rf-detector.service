[Unit]
Description=RF Detector (p5) — orquesta procesa_video.py + clasificador.py
After=network.target mysql.service
Wants=mysql.service

[Service]
Type=simple
WorkingDirectory=/root/reconocimientoFacial
ExecStart=/usr/bin/php /root/reconocimientoFacial/detector.php
Restart=always
RestartSec=5
User=root
# Prioridad de CPU BAJA (Tier 2/3, diferible): clasificador.py y procesa_video
# heredan Nice=10, por debajo de los capturadores en tiempo real (Nice=-10).
Nice=10
# Reparto de cores del host (10 vCPU): 0-1 reservados a web/DB/OS/live, 2-4 al
# capturador en tiempo real y 5-9 a la inferencia (este servicio).
# CPUAffinity usa sched_setaffinity y la heredan los hijos
# (clasificador.py/procesa_video.py). Aísla la latencia del panel del motor.
CPUAffinity=5-9
# Hilos fijos por proceso (anti-sobresuscripción): OMP/OpenBLAS/MKL a 1 (numpy
# del matching) y OpenCV a 1 (resize/blur/morph). Los hijos
# (clasificador.py/procesa_video.py) lo heredan.
Environment=OMP_NUM_THREADS=1
Environment=OPENBLAS_NUM_THREADS=1
Environment=MKL_NUM_THREADS=1
Environment=RF_CV_THREADS=1
# Hilos intra-op por sesión ONNX (motor/core/model.py). Con 5 sesiones por
# FaceAnalysis y 5 procesos de inferencia a la vez, el default (=cores físicos
# por sesión, ~50 hilos/proceso) hundía la máquina: runqueue ~50 sobre 10 cores
# y ~79k cambios de contexto/s. 2 hilos/sesión mantiene los 10 cores ocupados
# sin thrashing y NO cambia el resultado.
Environment=RF_ORT_THREADS=2
# Aceleración de inferencia: OpenVINO EP (~2,3x en Xeon) si está instalado, con
# fallback automático a CPU. Revertir sin tocar código: RF_ORT_PROVIDER=cpu.
Environment=RF_ORT_PROVIDER=openvino
# Tope de memoria del cgroup (detector + pool de clasificadores + procesa_video):
# con el pool (RF_CLASIF_CAMS_POR_PROC=8 -> 1 clasificador/8 cámaras) y la foto
# HQ fuera (worker único rf-photo), el pico baja de ~9G a ~5G. Si se supera, el
# OOM killer actúa DENTRO de rf (reinicia el proceso más grande) y nunca mata
# procesos de autotube. Ajustable a la RAM de la máquina.
MemoryMax=5G

[Install]
WantedBy=multi-user.target
