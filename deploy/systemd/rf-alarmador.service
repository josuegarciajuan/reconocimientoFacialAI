[Unit]
Description=RF Alarmador (p8) — La Almenara: despacho de alarmas y ronda de la mañana
After=network.target mysql.service
Wants=mysql.service

[Service]
Type=simple
WorkingDirectory=/root/reconocimientoFacial
ExecStart=/usr/bin/php /root/reconocimientoFacial/alarmador.php
Restart=always
RestartSec=5
User=root

[Install]
WantedBy=multi-user.target
