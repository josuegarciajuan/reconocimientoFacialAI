[Unit]
Description=RF Alarmador (p8) — La Almenara: despacho de alarmas y ronda de la mañana
After=network.target mysql.service
Wants=mysql.service

[Service]
Type=simple
WorkingDirectory=/root/reconocimientoFacial
ExecStart=/usr/bin/php /root/reconocimientoFacial/alarmador.php
Restart=always
RestartSec=5
User=root
# Ronda periódica ligera: cores de la web (0-2).
CPUAffinity=0-2

[Install]
WantedBy=multi-user.target
